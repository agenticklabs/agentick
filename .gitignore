# Top-level docs/ — ignored except v2 proposals, the archive, and the
# dev-loop docs below.
# Pattern note: must use /* on parents (not bare /), so child re-includes work.
/docs/*
!/docs/verdaccio.md
!/docs/proposals/
/docs/proposals/*
!/docs/proposals/v2/
!/docs/proposals/v2/**
!/docs/archive/
!/docs/archive/**

# Nested docs/ dirs (e.g., packages/mcp/docs/) stay ignored.
packages/*/docs/

!website/docs/

# ignore MCP
.mcp.json

.codex/

.claude/worktrees/*
