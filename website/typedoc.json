{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "../packages/spec",
    "../packages/runtime",
    "../packages/app",
    "../packages/session",
    "../packages/compiler",
    "../packages/compiler-react",
    "../packages/executor",
    "../packages/model",
    "../packages/model-openai",
    "../packages/model-anthropic",
    "../packages/model-google",
    "../packages/model-ai-sdk",
    "../packages/loop-executor",
    "../packages/tool-executor",
    "../packages/tool",
    "../packages/knobs",
    "../packages/state",
    "../packages/timeline",
    "../packages/timeline-fs",
    "../packages/timeline-postgres",
    "../packages/tasks-store-postgres",
    "../packages/skills",
    "../packages/completions",
    "../packages/prompts",
    "../packages/prompts-react",
    "../packages/client-react",
    "../packages/elicitation",
    "../packages/resources",
    "../packages/mcp",
    "../packages/gates",
    "../packages/formatters",
    "../packages/subscriptions",
    "../packages/spec-conformance",
    "../packages/sandbox",
    "../packages/sandbox-local",
    "../packages/sandbox-docker",
    "../packages/sandbox-lambda",
    "../packages/credentials",
    "../packages/telemetry-otlp",
    "../packages/connector",
    "../packages/gateway",
    "../packages/utils",
    "../packages/pubsub",
    "../packages/store",
    "../packages/tasks",
    "../packages/live",
    "../packages/cluster",
    "../packages/cluster-broker",
    "../packages/cluster-net",
    "../packages/cluster-ws",
    "../packages/cluster-redis"
  ],
  "out": "api",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "readme": "none",
  "entryFileName": "index",
  "hideGenerator": true,
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig.json",
    "indexFormat": "table",
    "parametersFormat": "table",
    "interfacePropertiesFormat": "table",
    "classPropertiesFormat": "table",
    "enumMembersFormat": "table",
    "typeDeclarationFormat": "table",
    "propertyMembersFormat": "table",
    "sanitizeComments": true,
    "useHTMLEncodedBrackets": true,
    "sort": ["kind", "alphabetical"],
    "kindSortOrder": ["Function", "Class", "Interface", "TypeAlias", "Variable", "Enum"],
    "categorizeByGroup": true,
    "excludeExternals": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "disableSources": false,
    "sourceLinkTemplate": "https://github.com/agenticklabs/agentick/blob/master/{path}#L{line}"
  }
}
