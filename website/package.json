{
  "name": "agentick-website",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "pnpm run generate:og && pnpm run docs:api && vitepress build",
    "build:no-api": "pnpm run generate:og && vitepress build",
    "preview": "vitepress preview",
    "generate:og": "node scripts/generate-og.js",
    "docs:api": "typedoc && node scripts/fix-api-docs.js",
    "docs:api:watch": "typedoc --watch"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.4.5"
  }
}
