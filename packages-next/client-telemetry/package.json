{
  "name": "@agentick/client-telemetry-next",
  "version": "0.0.0",
  "private": true,
  "description": "OpenTelemetry-shaped telemetry middleware for @agentick/client-next. W3C Trace Context propagation via `_meta.traceparent` / `_meta.tracestate`, span per logical RPC with OTel RPC semantic conventions, configurable Tracer (BYO @opentelemetry/api), per-method sampling override, counters + duration histograms via Meter.",
  "keywords": ["agent", "agentick", "ai", "client", "telemetry", "opentelemetry", "tracing"],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": { "type": "git", "url": "git+https://github.com/agenticklabs/agentick.git", "directory": "packages-next/client-telemetry" },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": { "@agentick/spec-next": "workspace:*" },
  "devDependencies": {
    "@agentick/client-next": "workspace:*",
    "@agentick/transport-in-process-next": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
