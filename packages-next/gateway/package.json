{
  "name": "@agentick/gateway-next",
  "version": "0.0.0",
  "private": true,
  "description": "GatewayHarness \u2014 v2 runtime-root harness (formerly @agentick/gateway/v2). Per ADR 31, hosts apps + owns top-level substrate.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/app-next": "workspace:*",
    "@agentick/cluster-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/model-executor-next": "workspace:*",
    "@agentick/compiler-react-next": "workspace:*",
    "@agentick/spec-conformance-next": "workspace:*"
  }
}
