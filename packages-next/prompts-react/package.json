{
  "name": "@agentick/prompts-react-next",
  "version": "0.0.0",
  "private": true,
  "description": "React binding for @agentick/prompts-next. Exports `reactPromptRenderer` (ReactNode → MessageEntry[] via compileTemplate) and the `withReactPrompts` convenience extension.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "prompts",
    "react"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/prompts-react"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/prompts-next": "workspace:*",
    "@agentick/compiler-react-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@agentick/runtime-next": "workspace:*",
    "@types/react": "^19.2.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
