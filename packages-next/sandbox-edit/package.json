{
  "name": "@agentick/sandbox-edit-next",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, OS-free surgical edit transform (applyEdits) — the crown-jewel layered-matching editor shared by the sandbox harness and every provider (ADR 59).",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/spec-next": "workspace:*"
  }
}
