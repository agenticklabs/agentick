{
  "name": "@agentick/reconciler-react-next",
  "version": "0.0.0",
  "description": "Reference reconciler harness for Agentick v2. Uses react-reconciler to drive JSX agent definitions and produces RenderedTree IR. Reference implementation of ReconcilerProtocol from @agentick/spec.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "react",
    "reconciler"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/reconciler-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentick/formatters-next": "workspace:*",
    "@agentick/reconciler-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/tool-next": "workspace:*",
    "effect": "^3.21.2",
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@agentick/spec-conformance-next": "workspace:*",
    "@types/react": "^19.2.5",
    "@types/react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
