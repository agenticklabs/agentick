{
  "name": "@agentick/spec-next",
  "version": "0.0.0",
  "description": "Canonical contract types and protocol interfaces for Agentick v2. Effect-typed, browser-safe. The firewall between compiler, runtime, executor, and topology wrappers.",
  "keywords": [
    "agent",
    "ai",
    "contract",
    "protocol",
    "spec",
    "types"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/spec"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "import": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol/index.ts",
      "import": "./src/protocol/index.ts",
      "default": "./src/protocol/index.ts"
    },
    "./guards": {
      "types": "./src/guards/index.ts",
      "import": "./src/guards/index.ts",
      "default": "./src/guards/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "import": "./dist/data/index.js",
        "default": "./dist/data/index.js"
      },
      "./protocol": {
        "types": "./dist/protocol/index.d.ts",
        "import": "./dist/protocol/index.js",
        "default": "./dist/protocol/index.js"
      },
      "./guards": {
        "types": "./dist/guards/index.d.ts",
        "import": "./dist/guards/index.js",
        "default": "./dist/guards/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "effect": "^3.21.2"
  }
}
