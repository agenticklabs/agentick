{
  "name": "@agentick/transport-in-process-next",
  "version": "0.0.0",
  "private": true,
  "description": "In-process `ClientTransport` for agentick — direct function calls between client and gateway in the same process. Used for tests, embedded library deploys, and same-process TUI / daemon shapes (tentickle-class agents). Zero serialization cost; optional `wireParity: true` test mode roundtrips frames through JSON to catch wire-shape regressions.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "in-process",
    "transport"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/transport-in-process"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/spec-next": "workspace:*",
    "@agentick/transport-next": "workspace:*"
  },
  "devDependencies": {
    "@agentick/app-next": "workspace:*",
    "@agentick/client-core-next": "workspace:*",
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/executor-next": "workspace:*",
    "@agentick/gateway-next": "workspace:*",
    "@agentick/reconciler-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-conformance-next": "workspace:*",
    "@agentick/tasks-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "effect": "^3.21.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
