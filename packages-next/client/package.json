{
  "name": "@agentick/client-next",
  "version": "0.0.0",
  "private": true,
  "description": "Batteries-included agentick client: re-exports `@agentick/client-core-next` and side-effect-imports every built-in `/client` subpath (tasks, knobs, elicitation, tool-executor) so their session sub-handles (`session.tasks` / `.knobs` / `.elicitations()` / `.registerTool()`) self-assemble with no per-harness imports. Interim stand-in for the public `agentick/client` metapackage entry until the v2 cut.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "client",
    "bundle"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/client"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/client-core-next": "workspace:*",
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/gates-next": "workspace:*",
    "@agentick/knobs-next": "workspace:*",
    "@agentick/tasks-next": "workspace:*",
    "@agentick/timeline-next": "workspace:*",
    "@agentick/tool-executor-next": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.0.18",
    "@agentick/transport-in-process-next": "workspace:*"
  }
}
