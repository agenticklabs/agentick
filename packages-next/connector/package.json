{
  "name": "@agentick/connector-next",
  "version": "0.0.0",
  "private": true,
  "description": "Connector base — bind a chat surface (Telegram, iMessage, …) to an agent session as one server-side GatewayExtension. Inbound platform messages → session.send; agent output → platform-native delivery; tool confirmations → the elicitation channel.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "connector",
    "chat",
    "gateway",
    "telegram",
    "imessage"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/connector"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/formatters-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/utils-next": "workspace:*"
  },
  "devDependencies": {
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/model-executor-next": "workspace:*",
    "@agentick/gateway-next": "workspace:*",
    "@agentick/model-next": "workspace:*",
    "@agentick/compiler-react-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "react": "^19.0.0"
  }
}
