{
  "name": "@agentick/executor-ai-sdk-next",
  "version": "0.0.0",
  "description": "Vercel AI SDK bridge for Agentick v2 — wraps any AI SDK LanguageModel as a LanguageModelExecutor. The progressive-adoption path: bring your existing AI SDK setup, get JSX agents + sessions + observability for free.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "ai-sdk",
    "executor",
    "harness",
    "vercel"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/executor-ai-sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "ai": "^5.0.0",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@agentick/spec-conformance-next": "workspace:*",
    "msw": "^2.0.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0"
  }
}
