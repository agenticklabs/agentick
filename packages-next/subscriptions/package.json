{
  "name": "@agentick/subscriptions-next",
  "version": "0.0.0",
  "description": "Long-lived subscription primitive for Agentick v2 — <Cron>, <Webhook>, <EventListener>. Bridge + JSX + in-process scheduler driver. The foundation that connectors build on.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "cron",
    "subscriptions",
    "webhook"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/subscriptions"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js",
        "default": "./dist/react/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/reconciler-next": "workspace:*",
    "@agentick/reconciler-react-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/utils-next": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.13"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
