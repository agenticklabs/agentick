{
  "name": "@agentick/gates-next",
  "version": "0.0.0",
  "private": true,
  "description": "Gates — knob-backed continuation conditions. Reconciler-agnostic descriptor types + factory at the top level; React hook in /react subpath. Not a harness; gates have no independent state — the gate's value IS a knob value. Bundled into the agentick metapackage; not published independently.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "gates",
    "knobs"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/gates"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentick/knobs-next": "workspace:*",
    "@agentick/reconciler-next": "workspace:*",
    "@agentick/reconciler-react-next": "workspace:*",
    "@agentick/spec-next": "workspace:*"
  },
  "devDependencies": {
    "@agentick/knobs-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@types/react": "^19.2.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  }
}
