{
  "name": "@agentick/model-next",
  "version": "0.0.0",
  "description": "The model layer for Agentick v2 (ADR 52) — zero Effect, zero substrate. Owns the LanguageModelAdapter contract, the stream accumulator + delta-transform pipeline, canonical projection, tag routing, and the standalone generate()/generateStream() helpers. Provider adapters (@agentick/model-openai-next, …) implement this contract; the executor harness consumes it.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "model",
    "adapter",
    "llm"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/model"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/spec-next": "workspace:*",
    "@agentick/utils-next": "workspace:*"
  }
}
