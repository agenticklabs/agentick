{
  "name": "@agentick/sandbox-local-next",
  "version": "0.0.0",
  "private": true,
  "description": "Local reference SandboxProvider — spawns commands in a temp workspace, path-confined fs, atomic editFile, dynamic mounts, and a 127.0.0.1 egress proxy (ADR 59).",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/sandbox-edit-next": "workspace:*",
    "@agentick/sandbox-net-next": "workspace:*",
    "@agentick/spec-next": "workspace:*"
  },
  "devDependencies": {
    "@agentick/spec-conformance-next": "workspace:*"
  }
}
