{
  "name": "@agentick/mcp-next",
  "version": "0.0.0",
  "private": true,
  "description": "MCP client harness — connects an agentick session to N Model Context Protocol servers. Per-server McpClientHarness with pluggable Transport / Auth / Protocol / Lifecycle layers. Server discovery → local ToolExecutor registration; inbound elicitation → ElicitationHarness. Targets MCP 'draft' spec going forward; supports 2025-11-25 latest official. Bundled into the agentick metapackage; not published independently.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "mcp",
    "model-context-protocol",
    "oauth"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/mcp"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./oauth": {
      "types": "./src/oauth/index.ts",
      "import": "./src/oauth/index.ts",
      "default": "./src/oauth/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/tool-executor-next": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@agentick/app-next": "workspace:*",
    "@agentick/executor-next": "workspace:*",
    "@agentick/reconciler-next": "workspace:*",
    "@agentick/spec-conformance-next": "workspace:*",
    "@agentick/tasks-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "@types/react": "^19.2.5",
    "react": "^19.2.4"
  }
}
