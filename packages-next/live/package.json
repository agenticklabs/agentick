{
  "name": "@agentick/live-next",
  "version": "0.0.0",
  "private": true,
  "description": "LiveHarness — the real-time media plane (ADR 88). Streams mic audio / video frames up and media down over a session-scoped MediaSession keyed by (sessionId, streamId), with a MediaTransport capability, stream routing, and the session.live client handle (sendFrame/onFrame spec + uplink/downlink WritableStream/ReadableStream projections). v0 minimal core: transport contract + handle + routing + wire; the STT/TTS engine, TurnArbiter, and realtime-provider integration are deferred (composed by the adopter from existing primitives). OPTIONAL extension — installed separately, not bundled.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "live",
    "media",
    "realtime",
    "voice"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/live"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/client-core-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@agentick/model-executor-next": "workspace:*",
    "@agentick/gateway-next": "workspace:*",
    "@agentick/compiler-next": "workspace:*",
    "@agentick/transport-in-process-next": "workspace:*"
  }
}
