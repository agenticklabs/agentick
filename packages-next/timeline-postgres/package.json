{
  "name": "@agentick/timeline-postgres-next",
  "version": "0.0.0",
  "private": true,
  "description": "postgresTimelineStore — Postgres TimelineStore adapter (ADR 49). The shared source of truth across stateless replicas (the cloud pole). BYO pg.Pool; DB-assigned IDENTITY seq; jsonb payloads; full schema escape hatches.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "postgres",
    "store",
    "timeline"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages-next/timeline-postgres"
  },
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/timeline-next": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
