{
  "name": "@agentick/app-next",
  "version": "0.0.0",
  "description": "Reference app harness for Agentick v2. Outermost runtime boundary — owns shared substrate, shared sub-harnesses (compiler, loop, executor), the session registry, and the createApp ergonomic surface. Compiler-agnostic — adopters writing React agents import from `@agentick/app-next/react` for the React default.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "app",
    "harness"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/app"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js",
        "default": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.0",
    "@effect/platform": "^0.97.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@agentick/cluster-next": "workspace:*",
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/loop-executor-next": "workspace:*",
    "@agentick/model-next": "workspace:*",
    "@agentick/resources-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/session-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/tasks-next": "workspace:*",
    "@agentick/timeline-next": "workspace:*",
    "@agentick/tool-executor-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/compiler-next": "workspace:*",
    "@agentick/compiler-react-next": "workspace:*",
    "@agentick/knobs-next": "workspace:*",
    "@agentick/model-executor-next": "workspace:*",
    "@types/react": "^19.2.5",
    "react": "^19.2.4"
  },
  "peerDependencies": {
    "@agentick/compiler-react-next": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentick/compiler-react-next": {
      "optional": true
    }
  }
}
