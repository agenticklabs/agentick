{
  "name": "@agentick/client-cache-next",
  "version": "0.0.0",
  "private": true,
  "description": "Read-through cache middleware for @agentick/client-next. Per-method TTL, LRU eviction, event-driven invalidation. Method-explicit-allowlist by default (most agentick methods are stateful — do NOT cache without thought). Same family as React Query / TanStack Query / SWR / Apollo Client cache.",
  "keywords": ["agent", "agentick", "ai", "client", "cache", "lru"],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": { "type": "git", "url": "git+https://github.com/agenticklabs/agentick.git", "directory": "packages-next/client-cache" },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": { "@agentick/spec-next": "workspace:*" },
  "devDependencies": {
    "@agentick/client-next": "workspace:*",
    "@agentick/transport-in-process-next": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
