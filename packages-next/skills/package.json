{
  "name": "@agentick/skills-next",
  "version": "0.0.0",
  "private": true,
  "description": "SkillsHarness — durable library of reusable agent skills. OpenClaw / Hermes style: searchable, shareable, persistent across sessions. Shape 1 harness per ADR 32 (audit + swappable backend + cross-session persistence).",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "skills"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/skills"
  },
  "type": "module",
  "main": "src/index.ts",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@agentick/spec-conformance-next": "workspace:*"
  }
}
