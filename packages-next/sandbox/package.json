{
  "name": "@agentick/sandbox-next",
  "version": "0.0.0",
  "private": true,
  "description": "Base sandbox package (ADR 59) — the SandboxHarness + bridge + ACL, the SandboxProvider construction contract + SandboxHandle interface, the applyEdits transform, and the pure network matcher. Providers dep this base (mirroring model-openai-next → model-next). React bindings ship from /react; the conformance suite + fake from /testing.",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/pubsub-next": "workspace:*",
    "@agentick/reconciler-next": "workspace:*",
    "@agentick/reconciler-react-next": "workspace:*",
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/tool-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
