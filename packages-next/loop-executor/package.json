{
  "name": "@agentick/loop-executor-next",
  "version": "0.0.0",
  "description": "Reference loop executor harness for Agentick v2. Orchestrates one agent execution by composing the compiler, executor, and tool-executor harnesses through the canonical tick loop.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "loop",
    "orchestration"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/loop-executor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "@agentick/utils-next": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/elicitation-next": "workspace:*",
    "@agentick/model-executor-next": "workspace:*",
    "@agentick/spec-conformance-next": "workspace:*",
    "@agentick/tool-executor-next": "workspace:*"
  },
  "engines": {
    "node": ">=20.19"
  }
}
