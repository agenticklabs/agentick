{
  "name": "@agentick/executor-next",
  "version": "0.0.0",
  "description": "Reference executor harness for Agentick v2. Implements ExecutorProtocol from @agentick/spec-next — project / execute / normalize / run / abort. Ships MockLanguageModelExecutor for tests + reference; provider adapters (OpenAI, Anthropic, Google, AI SDK) live in separate packages.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "executor",
    "harness"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/executor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/runtime-next": "workspace:*",
    "@agentick/spec-next": "workspace:*",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@agentick/spec-conformance-next": "workspace:*"
  }
}
