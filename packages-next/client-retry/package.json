{
  "name": "@agentick/client-retry-next",
  "version": "0.0.0",
  "private": true,
  "description": "Retry middleware for @agentick/client-next. Exponential backoff with full jitter (AWS Builder's Library), configurable retryable predicate, idempotency-key propagation via `_meta.idempotencyKey`, per-method overrides. Same family as axios-retry, got, undici-retry-fetch, AWS SDK retry strategies.",
  "keywords": ["agent", "agentick", "ai", "client", "retry", "backoff"],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": { "type": "git", "url": "git+https://github.com/agenticklabs/agentick.git", "directory": "packages-next/client-retry" },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": { "@agentick/spec-next": "workspace:*" },
  "devDependencies": {
    "@agentick/client-next": "workspace:*",
    "@agentick/transport-in-process-next": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
