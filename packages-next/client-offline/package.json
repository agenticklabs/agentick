{
  "name": "@agentick/client-offline-next",
  "version": "0.0.0",
  "private": true,
  "description": "Offline queue middleware for @agentick/client-next. Buffers outbound RPCs when the wire is closed; replays FIFO on reconnect. Pluggable durable store (in-memory default; adopter wires IndexedDB / SQLite / Redis). Per-method queueable policy. Same family as Workbox BackgroundSync, Apollo Link Queue, Redux Offline.",
  "keywords": ["agent", "agentick", "ai", "client", "offline", "queue", "outbox"],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": { "type": "git", "url": "git+https://github.com/agenticklabs/agentick.git", "directory": "packages-next/client-offline" },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": { "@agentick/spec-next": "workspace:*" },
  "devDependencies": {
    "@agentick/client-next": "workspace:*",
    "@agentick/transport-in-process-next": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
