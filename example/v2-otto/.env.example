# Agentick v2 — end-to-end example credentials
#
# Copy this file to `.env` and fill in the values.
# The example uses OpenAI via the AI SDK adapter. To use a different
# provider (Anthropic, Google, etc.), edit src/index.ts to import a
# different `@ai-sdk/<provider>` and set the matching env var.

# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
