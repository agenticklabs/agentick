{
  "name": "example-v2-otto",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end Agentick v2 example using a REAL model. Provider: OpenAI via the AI SDK adapter. Demonstrates ergonomics: JSX agent, inline createTool, useKnob for runtime knobs, app.send() shortcut.",
