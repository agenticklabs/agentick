# Agentick v2 — coding-agent example credentials
#
# Copy this file to `.env` and fill in the value. The example drives a real
# model (OpenAI via the AI SDK adapter) so the agent actually reads/writes files
# and runs shell commands in a scratch workspace. To use a different provider,
# swap the `@ai-sdk/<provider>` import + adapter in src/server.ts.

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=
