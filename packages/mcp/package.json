{
  "name": "@agentick/mcp",
  "version": "0.14.50",
  "description": "MCP server and client for Agentick — standalone, pluggable, world-class",
  "keywords": [
    "agent",
    "ai",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "typesVersions": {
    "*": {
      "server": [
        "dist/server/index.d.ts"
      ],
      "client": [
        "dist/client/index.d.ts"
      ],
      "transport": [
        "dist/transport/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "import": "./dist/transport/index.js",
      "default": "./dist/transport/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js",
        "default": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./transport": {
        "types": "./dist/transport/index.d.ts",
        "import": "./dist/transport/index.js",
        "default": "./dist/transport/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentick/kernel": "workspace:*",
    "@agentick/shared": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
