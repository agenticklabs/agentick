{
  "name": "@agentick/mcp",
  "version": "1.0.0-next.115",
  "description": "MCP client harness — connects an agentick session to N Model Context Protocol servers. Per-server McpClientHarness with pluggable Transport / Auth / Protocol / Lifecycle layers. Server discovery → local ToolExecutor registration; inbound elicitation → ElicitationHarness. Targets MCP 'draft' spec going forward; supports 2025-11-25 latest official. Bundled into the agentick metapackage; not published independently.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "mcp",
    "model-context-protocol",
    "oauth"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "agentick-mcp-server": "./src/server/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./src/server/index.ts",
    "./src/server/augment.ts",
    "./dist/index.js",
    "./dist/augment.js",
    "./dist/server/index.js",
    "./dist/server/augment.js",
    "./src/client/*",
    "./dist/client/*",
    "./src/react/*",
    "./dist/react/*"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./oauth": {
      "types": "./src/oauth/index.ts",
      "import": "./src/oauth/index.ts",
      "default": "./src/oauth/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "agentick-mcp-server": "./dist/server/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./oauth": {
        "types": "./dist/oauth/index.d.ts",
        "import": "./dist/oauth/index.js",
        "default": "./dist/oauth/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js",
        "default": "./dist/server/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "oauth": [
          "./dist/oauth/index.d.ts"
        ],
        "server": [
          "./dist/server/index.d.ts"
        ],
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/completions": "workspace:*",
    "@agentick/elicitation": "workspace:*",
    "@agentick/prompts": "workspace:*",
    "@agentick/pubsub": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/tasks": "workspace:*",
    "@agentick/tool": "workspace:*",
    "@agentick/tool-executor": "workspace:*",
    "@agentick/utils": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/app": "workspace:*",
    "@agentick/compiler": "workspace:*",
    "@agentick/credentials": "workspace:*",
    "@agentick/model-executor": "workspace:*",
    "@agentick/resources": "workspace:*",
    "@agentick/spec-conformance": "workspace:*",
    "@agentick/utils": "workspace:*",
    "@types/react": "^19.2.5",
    "react": "^19.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
