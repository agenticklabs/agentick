{
  "name": "@agentick/live",
  "version": "1.0.0-next.87",
  "description": "LiveHarness — the real-time media plane (ADR 88). Streams mic audio / video frames up and media down over a session-scoped MediaSession keyed by (sessionId, streamId), with a MediaTransport capability, stream routing, and the session.live client handle (sendFrame/onFrame spec + uplink/downlink WritableStream/ReadableStream projections). v0 minimal core: transport contract + handle + routing + wire; the STT/TTS engine, TurnArbiter, and realtime-provider integration are deferred (composed by the adopter from existing primitives). OPTIONAL extension — installed separately, not bundled.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "live",
    "media",
    "realtime",
    "voice"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/live"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js",
    "./src/client/*",
    "./dist/client/*",
    "./src/react/*",
    "./dist/react/*"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "client": [
          "./dist/client/index.d.ts"
        ],
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/client-core": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/utils": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/compiler": "workspace:*",
    "@agentick/gateway": "workspace:*",
    "@agentick/model-executor": "workspace:*",
    "@agentick/transport-in-process": "workspace:*"
  },
  "engines": {
    "node": ">=20.19"
  }
}
