{
  "name": "@agentick/app",
  "version": "0.0.0",
  "description": "Reference app harness for Agentick v2. Outermost runtime boundary — owns shared substrate, shared sub-harnesses (reconciler, loop, executor), the session registry, and the createApp ergonomic surface. Reconciler-agnostic — adopters writing React agents import from `@agentick/app/react` for the React default.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "app",
    "harness"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/app"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js",
        "default": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@agentick/loop-executor": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/session": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/tool-executor": "workspace:*",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@agentick/executor": "workspace:*",
    "@agentick/knobs": "workspace:*",
    "@agentick/reconciler-react": "workspace:*",
    "@types/react": "^19.2.5",
    "react": "^19.2.4"
  },
  "peerDependencies": {
    "@agentick/reconciler-react": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentick/reconciler-react": { "optional": true }
  }
}
