{
  "name": "@agentick/code-host",
  "version": "1.0.0-next.115",
  "description": "Host-engine-adaptive subprocess Runtime for @agentick/code — spawns process.execPath (node or bun), ndjson control channel on a dedicated fd, bindings marshaled across the membrane, timeMs/outputBytes enforced everywhere and memoryMb where the engine honors a heap ceiling. Placement, not containment.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "bun",
    "code",
    "node",
    "runtime",
    "subprocess"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/code-host"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/supervisor.mjs dist/supervisor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/code": "workspace:*",
    "@agentick/sandbox": "workspace:*",
    "@agentick/spec": "workspace:*",
    "esbuild": "^0.27.3"
  },
  "devDependencies": {
    "@agentick/sandbox-local": "workspace:*",
    "effect": "^3.22.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
