{
  "name": "@agentick/tasks-store-postgres",
  "version": "1.0.0-next.181",
  "description": "postgresTaskStore — Postgres TaskStore adapter (ADR 68 pg tier). Durable task records across app-process restart, real interrupted-on-restart orphan accounting, terminal adoption across a fresh harness (the flexible cloud pole). BYO pg.Pool; jsonb payloads; full schema escape hatches.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "postgres",
    "store",
    "tasks"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/tasks-store-postgres"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/spec": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@agentick/store": "workspace:*",
    "@agentick/tasks": "workspace:*",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
