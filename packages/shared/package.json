{
  "name": "@agentick/shared",
  "version": "0.14.33",
  "description": "Shared types and utilities for Agentick",
  "keywords": [
    "agent",
    "ai",
    "types"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/shared"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "typesVersions": {
    "*": {
      "blocks": [
        "dist/blocks.d.ts"
      ],
      "block-types": [
        "dist/block-types.d.ts"
      ],
      "tools": [
        "dist/tools.d.ts"
      ],
      "input": [
        "dist/input.d.ts"
      ],
      "messages": [
        "dist/messages.d.ts"
      ],
      "streaming": [
        "dist/streaming.d.ts"
      ],
      "models": [
        "dist/models.d.ts"
      ],
      "timeline": [
        "dist/timeline.d.ts"
      ],
      "errors": [
        "dist/errors.d.ts"
      ],
      "identity": [
        "dist/identity.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "transport": [
        "dist/transport.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./blocks": "./src/blocks.ts",
    "./block-types": "./src/block-types.ts",
    "./tools": "./src/tools.ts",
    "./input": "./src/input.ts",
    "./messages": "./src/messages.ts",
    "./streaming": "./src/streaming.ts",
    "./models": "./src/models.ts",
    "./timeline": "./src/timeline.ts",
    "./errors": "./src/errors.ts",
    "./identity": "./src/identity.ts",
    "./testing": "./src/testing/index.ts",
    "./utils": "./src/utils/index.ts",
    "./transport": "./src/transport.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./blocks": {
        "types": "./dist/blocks.d.ts",
        "import": "./dist/blocks.js",
        "default": "./dist/blocks.js"
      },
      "./block-types": {
        "types": "./dist/block-types.d.ts",
        "import": "./dist/block-types.js",
        "default": "./dist/block-types.js"
      },
      "./tools": {
        "types": "./dist/tools.d.ts",
        "import": "./dist/tools.js",
        "default": "./dist/tools.js"
      },
      "./input": {
        "types": "./dist/input.d.ts",
        "import": "./dist/input.js",
        "default": "./dist/input.js"
      },
      "./messages": {
        "types": "./dist/messages.d.ts",
        "import": "./dist/messages.js",
        "default": "./dist/messages.js"
      },
      "./streaming": {
        "types": "./dist/streaming.d.ts",
        "import": "./dist/streaming.js",
        "default": "./dist/streaming.js"
      },
      "./models": {
        "types": "./dist/models.d.ts",
        "import": "./dist/models.js",
        "default": "./dist/models.js"
      },
      "./timeline": {
        "types": "./dist/timeline.d.ts",
        "import": "./dist/timeline.js",
        "default": "./dist/timeline.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "import": "./dist/errors.js",
        "default": "./dist/errors.js"
      },
      "./identity": {
        "types": "./dist/identity.d.ts",
        "import": "./dist/identity.js",
        "default": "./dist/identity.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "import": "./dist/utils/index.js",
        "default": "./dist/utils/index.js"
      },
      "./transport": {
        "types": "./dist/transport.d.ts",
        "import": "./dist/transport.js",
        "default": "./dist/transport.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "echo \"Tests run from workspace root\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "prepublishOnly": "pnpm build",
    "dev": "tsc --watch"
  }
}
