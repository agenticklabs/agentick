{
  "name": "@agentick/model-openai",
  "version": "1.0.0-next.42",
  "description": "OpenAI LanguageModelAdapter for Agentick v2 (ADR 52). openai(model?, options?) — the provider-normalization part consumed by @agentick/model-executor's LanguageModelExecutor. Zero Effect, zero substrate.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "executor",
    "harness",
    "openai"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/model-openai"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/model": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/utils": "workspace:*",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@agentick/model-executor": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/spec-conformance": "workspace:*",
    "effect": "^3.22.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
