{
  "name": "@agentick/eval",
  "version": "1.0.0-next.158",
  "description": "Testing-shaped eval framework for Agentick v2. `defineEval(...)` returns a callable function with runtime parameterization (model swap, fixture injection, tool stubs); a single eval definition supports matrix runs, A/B sweeps, and CI-vs-prod profiles. Inspired by Eve evals; Agentick twist: defineEval returns a function, not a config. See ADR 37.",
  "keywords": [
    "agentick",
    "eval",
    "testing"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/eval"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugins/workspace": {
      "types": "./src/plugins/workspace.ts",
      "import": "./src/plugins/workspace.ts",
      "default": "./src/plugins/workspace.ts"
    },
    "./plugins/judge": {
      "types": "./src/plugins/judge.ts",
      "import": "./src/plugins/judge.ts",
      "default": "./src/plugins/judge.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./plugins/workspace": {
        "types": "./dist/plugins/workspace.d.ts",
        "import": "./dist/plugins/workspace.js",
        "default": "./dist/plugins/workspace.js"
      },
      "./plugins/judge": {
        "types": "./dist/plugins/judge.d.ts",
        "import": "./dist/plugins/judge.js",
        "default": "./dist/plugins/judge.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "plugins/workspace": [
          "./dist/plugins/workspace.d.ts"
        ],
        "plugins/judge": [
          "./dist/plugins/judge.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/app": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/utils": "workspace:*"
  },
  "devDependencies": {
    "@agentick/compiler-react": "workspace:*",
    "@agentick/model-executor": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@types/react": "^19.2.5",
    "react": "^19.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
