{
  "name": "@agentick/store",
  "version": "1.0.0-next.136",
  "description": "Generic store substrate for Agentick v2 — the `MemoryCollection<T, Q>` in-memory collection-store generic and the `runStoreConformance` shared conformance skeleton. Parameterize one generic (backend / keyOf / matchQuery / prunePredicate) to get a store-backed harness's default backing; no hand-rolled `Map` per harness. Implements the `CollectionStore<T, Q>` port from `@agentick/spec`. Bundled into the agentick metapackage; not published independently.",
  "keywords": [
    "agentick",
    "collection",
    "conformance",
    "store",
    "substrate"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/store"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/pubsub": "workspace:*",
    "@agentick/spec": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/runtime": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
