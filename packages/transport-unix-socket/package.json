{
  "name": "@agentick/transport-unix-socket",
  "version": "1.0.0-next.129",
  "description": "Unix-socket transport for agentick — newline-delimited JSON-RPC 2.0 over `net.Server` / `net.Socket`. Required for tentickle-class local-IPC shapes (TUI ↔ same-host daemon). Node-only.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "ipc",
    "json-rpc",
    "transport",
    "unix-socket"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/transport-unix-socket"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": null,
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "browser": null,
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "browser": null,
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "browser": null,
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "browser": null,
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./server": {
        "browser": null,
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js",
        "default": "./dist/server/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "client": [
          "./dist/client/index.d.ts"
        ],
        "server": [
          "./dist/server/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/spec": "workspace:*",
    "@agentick/transport": "workspace:*",
    "@agentick/utils": "workspace:*"
  },
  "devDependencies": {
    "@agentick/client-core": "workspace:*",
    "@agentick/gateway": "workspace:*",
    "@agentick/spec-conformance": "workspace:*",
    "effect": "^3.22.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19"
  }
}
