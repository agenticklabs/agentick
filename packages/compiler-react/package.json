{
  "name": "@agentick/compiler-react",
  "version": "1.0.0-next.103",
  "description": "Reference compiler harness for Agentick v2. Uses react-reconciler to drive JSX agent definitions and produces RenderedTree IR. Reference implementation of CompilerProtocol from @agentick/spec.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "compiler",
    "harness",
    "react"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/compiler-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/compiler": "workspace:*",
    "@agentick/formatters": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/tool": "workspace:*",
    "@agentick/utils": "workspace:*",
    "effect": "^3.22.0",
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@agentick/spec-conformance": "workspace:*",
    "@types/react": "^19.2.5",
    "@types/react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
