{
  "name": "@agentick/skills",
  "version": "1.0.0-next.56",
  "description": "SkillsHarness — durable library of reusable agent skills. OpenClaw / Hermes style: searchable, shareable, persistent across sessions. Shape 1 harness per ADR 32 (audit + swappable backend + cross-session persistence).",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "skills"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/skills"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js",
    "./src/client/*",
    "./dist/client/*",
    "./src/react/*",
    "./dist/react/*"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./hydrators": {
      "types": "./src/hydrators.ts",
      "import": "./src/hydrators.ts",
      "default": "./src/hydrators.ts"
    },
    "./hydrators/node": {
      "types": "./src/hydrators-node.ts",
      "import": "./src/hydrators-node.ts",
      "default": "./src/hydrators-node.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      },
      "./hydrators": {
        "types": "./dist/hydrators.d.ts",
        "import": "./dist/hydrators.js",
        "default": "./dist/hydrators.js"
      },
      "./hydrators/node": {
        "types": "./dist/hydrators-node.d.ts",
        "import": "./dist/hydrators-node.js",
        "default": "./dist/hydrators-node.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "client": [
          "./dist/client/index.d.ts"
        ],
        "testing": [
          "./dist/testing/index.d.ts"
        ],
        "hydrators": [
          "./dist/hydrators.d.ts"
        ],
        "hydrators/node": [
          "./dist/hydrators-node.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/client-core": "workspace:*",
    "@agentick/pubsub": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/store": "workspace:*",
    "@agentick/utils": "workspace:*",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@agentick/resources": "workspace:*",
    "@agentick/spec-conformance": "workspace:*"
  },
  "engines": {
    "node": ">=20.19"
  }
}
