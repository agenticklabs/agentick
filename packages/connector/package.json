{
  "name": "@agentick/connector",
  "version": "1.0.0-next.68",
  "description": "Connector base — bind a chat surface (Telegram, iMessage, …) to an agent session as one server-side GatewayExtension. Inbound platform messages → session.send; agent output → platform-native delivery; tool confirmations → the elicitation channel.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "chat",
    "connector",
    "gateway",
    "imessage",
    "telegram"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/connector"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/augment.ts",
    "./dist/index.js",
    "./dist/augment.js",
    "./src/client/*",
    "./dist/client/*",
    "./src/react/*",
    "./dist/react/*"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/formatters": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/utils": "workspace:*"
  },
  "devDependencies": {
    "@agentick/compiler-react": "workspace:*",
    "@agentick/elicitation": "workspace:*",
    "@agentick/gateway": "workspace:*",
    "@agentick/model": "workspace:*",
    "@agentick/model-executor": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@types/react": "^19.2.5",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
