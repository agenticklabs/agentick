{
  "name": "@agentick/subscriptions",
  "version": "0.0.0",
  "description": "Long-lived subscription primitive for Agentick v2 — <Cron>, <Webhook>, <EventListener>. Bridge + JSX + in-process scheduler driver. The foundation that connectors build on.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "cron",
    "subscriptions",
    "webhook"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/subscriptions"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js",
        "default": "./dist/react/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@agentick/reconciler": "workspace:*",
    "@agentick/reconciler-react": "workspace:*",
    "@agentick/runtime": "workspace:*",
    "@agentick/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.13"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  }
}
