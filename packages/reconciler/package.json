{
  "name": "@agentick/reconciler",
  "version": "0.0.0",
  "description": "Reconciler-agnostic base for Agentick v2. Owns the callback-style `defineReconciler` factory and reconciler-flavored utilities that don't depend on a specific JSX runtime. Concrete reconcilers (React, Angular, …) depend on this and ship as separate packages.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "harness",
    "reconciler"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/reconciler"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@agentick/runtime": "workspace:*",
    "@agentick/spec": "workspace:*",
    "effect": "^3.21.2"
  }
}
