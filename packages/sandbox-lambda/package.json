{
  "name": "@agentick/sandbox-lambda",
  "version": "1.0.0-next.114",
  "description": "AWS Lambda MicroVMs SandboxProvider — one Firecracker microVM per sandbox, an in-VM sandbox-agent serving the contract over HTTP+WS, exec streamed frame-by-frame, atomic editFile via applyEdits, domain-level egress via an in-VM proxy. The prod remote runtime (ADR 60).",
  "bin": {
    "agentick-sandbox-agent": "./src/agent/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts",
      "default": "./src/agent/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "agentick-sandbox-agent": "./dist/agent/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./agent": {
        "types": "./dist/agent/index.d.ts",
        "import": "./dist/agent/index.js",
        "default": "./dist/agent/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "agent": [
          "./dist/agent/index.d.ts"
        ],
        "testing": [
          "./dist/testing/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/sandbox": "workspace:*",
    "@aws-sdk/client-lambda-microvms": "^3.1080.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
