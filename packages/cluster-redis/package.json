{
  "name": "@agentick/cluster-redis",
  "version": "1.0.0-next.111",
  "description": "Redis cluster transport for Agentick v2. The production multi-host story — adopters reach for Redis (or Valkey / KeyDB / Dragonfly, RESP-protocol-compatible) for clustering instead of running our own broker process. Pub/sub for the event bus + inbox; SET + TTL heartbeats for membership. No leader election; no broker to deploy — adopters use the Redis HA they already have (Sentinel / Cluster). Built directly against `ioredis`; symmetric across all nodes (no broker/client role distinction).",
  "keywords": [
    "agentick",
    "cluster",
    "dragonfly",
    "keydb",
    "pubsub",
    "redis",
    "valkey"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/cluster-redis"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/cluster": "workspace:*",
    "@agentick/spec": "workspace:*",
    "@agentick/utils": "workspace:*"
  },
  "devDependencies": {
    "ioredis": "^5.4.0"
  },
  "peerDependencies": {
    "ioredis": "^5.4.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
