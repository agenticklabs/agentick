{
  "name": "@agentick/client-extensions",
  "version": "1.0.0-next.107",
  "description": "First-party extensions (middleware) for @agentick/client-core. Subpath exports — adopters opt into individual behaviors: retry, telemetry, cache, offline. Tree-shakeable. Same family pattern as Apollo Link / TanStack Query plugins.",
  "keywords": [
    "agent",
    "agentick",
    "ai",
    "cache",
    "client",
    "extension",
    "middleware",
    "offline",
    "retry",
    "telemetry"
  ],
  "license": "MIT",
  "author": "Ryan Lindgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticklabs/agentick.git",
    "directory": "packages/client-extensions"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./retry": {
      "types": "./src/retry/index.ts",
      "import": "./src/retry/index.ts",
      "default": "./src/retry/index.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry/index.ts",
      "import": "./src/telemetry/index.ts",
      "default": "./src/telemetry/index.ts"
    },
    "./cache": {
      "types": "./src/cache/index.ts",
      "import": "./src/cache/index.ts",
      "default": "./src/cache/index.ts"
    },
    "./offline": {
      "types": "./src/offline/index.ts",
      "import": "./src/offline/index.ts",
      "default": "./src/offline/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./retry": {
        "types": "./dist/retry/index.d.ts",
        "import": "./dist/retry/index.js",
        "default": "./dist/retry/index.js"
      },
      "./telemetry": {
        "types": "./dist/telemetry/index.d.ts",
        "import": "./dist/telemetry/index.js",
        "default": "./dist/telemetry/index.js"
      },
      "./cache": {
        "types": "./dist/cache/index.d.ts",
        "import": "./dist/cache/index.js",
        "default": "./dist/cache/index.js"
      },
      "./offline": {
        "types": "./dist/offline/index.d.ts",
        "import": "./dist/offline/index.js",
        "default": "./dist/offline/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "retry": [
          "./dist/retry/index.d.ts"
        ],
        "telemetry": [
          "./dist/telemetry/index.d.ts"
        ],
        "cache": [
          "./dist/cache/index.d.ts"
        ],
        "offline": [
          "./dist/offline/index.d.ts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "format:check": "oxfmt --check src/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@agentick/spec": "workspace:*",
    "@agentick/utils": "workspace:*"
  },
  "devDependencies": {
    "@agentick/client-core": "workspace:*",
    "@agentick/transport-in-process": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19"
  }
}
